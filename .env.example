# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgres://car:car@localhost:54329/car_dev
TEST_DATABASE_URL=postgres://car:car@localhost:54329/car_test
PORT=3001
# Supabase (Vercel env, never committed): transaction pooler, port 6543, verified TLS.
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=db/certs/supabase-root-2021.crt
# Migrations use the session pooler (port 5432): session advisory locks do not hold in transaction mode.
